{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="page-width section-{{ section.id }}-padding">
  <ul>
    <li>{{ localization.language.iso_code }}</li>
    {% for language_item in metaobjects.language_flags.values %}
      {% for language_flags in language_item.language_list.value %}
        {% assign country_iso_code_downcase = language_flags.country_iso_code | downcase %}
        {% assign country_flag_src = '//cdn.shopify.com/static/images/flags/' | append: country_iso_code_downcase | append: '.svg?width=32' %}
        <li>{{ language_flags.language }}</li>
        <li>{{ language_flags.language_iso_code }}</li>
        <li>{{ language_flags.country }}</li>
        <li>{{ language_flags.country_iso_code }}</li>
        <li>
          <img src="{{ country_flag_src }}" srcset="{{ country_flag_src }} 32w" alt="{{ language_flags.country }}" width="32" height="24">
        </li>
      {% endfor %}
    {% endfor %}
  </ul>
</div>

{% schema %}
{
  "name": "Language country",
  "class": "section--language-country",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Language country"
    }
  ]
}
{% endschema %}
